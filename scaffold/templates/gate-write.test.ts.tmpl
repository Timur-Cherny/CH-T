// Молча ломалось: {{failure}}
// INVARIANT: {{invariant}}
// Обе стороны обязательны: deny по РАЗНЫМ причинам, silent по разным причинам, unknown — когда доказать нечем;
// kill-switch проверяется через route(): вердикт silent и ни одной записи в состояние.
import { describe, it, after } from 'node:test';
import assert from 'node:assert/strict';
import { readdirSync } from 'node:fs';
import { sandbox, payload, onlyGate, HARNESS_ROOT } from '../_env.ts';
import { decide, NAME, KILL, TARGET } from '../../src/gates/{{name}}.ts';
import { route } from '../../src/main.ts';
import type { GateContext, HookPayload, Verdict } from '../../src/types.ts';

const sb = sandbox();
after(() => sb.cleanup());
const write = (file_path: string): HookPayload => payload('PreToolUse', { tool_name: 'Write', tool_input: { file_path, content: 'x' }, tool_use_id: 'toolu_w' }) as unknown as HookPayload;
const run = (file: string, env: NodeJS.ProcessEnv = {}): Verdict => {
  const ctx: GateContext = { event: 'pre-write', payload: write(file), env, root: HARNESS_ROOT, stateDir: sb.stateDir, now: Date.now };
  return decide(ctx);
};

describe(NAME, () => {
  it('stays silent on a file that is not its business', () => { assert.equal(run('/r/src/app.ts').kind, 'silent'); });
  it('does not pass the judged file before the rule is written', () => { assert.equal(run(`/r/${TARGET}/x`).kind, 'unknown'); });
  it.todo('denies <нарушение 1> — первая причина');
  it.todo('denies <нарушение 2> — другая причина');
  it.todo('allows <норма> — допустимая форма того же файла');
  it(`is not invoked at all under ${KILL}=1 and writes nothing`, async () => {
    const before = readdirSync(sb.stateDir).length;
    const v = await route('pre-write', write(`/r/${TARGET}/x`) as never, { HOME: sb.home, CLAUDE_STATE_DIR: sb.stateDir, HARNESS_ROOT, ...onlyGate(NAME), [KILL]: '1' });
    assert.equal(v.kind, 'silent');
    assert.equal(readdirSync(sb.stateDir).length, before);
  });
});
